# Copy to .env. Never publish this file after adding credentials.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID, not @username. Groups are not allowed.
TELEGRAM_OWNER_ID=
OLLAMA_URL=http://127.0.0.1:11434
DATABASE_PATH=data/bot.db
KNOWLEDGE_PATH=knowledge/base.json
FILES_DIR=knowledge/files
REQUEST_TIMEOUT_SECONDS=120
HISTORY_PAIRS=5
# Minimum cosine similarity when there is no exact match.
MIN_SIMILARITY=0.53
